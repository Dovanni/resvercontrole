{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resvercontrole",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "secrets": {
    "required": ["SUPABASE_SERVICE_ROLE_KEY"]
  },
  "observability": {
    "enabled": true
  }
}
